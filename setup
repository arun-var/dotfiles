#!/usr/bin/env bash

set -e # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Base directories
export XDG_CONFIG_HOME="$HOME/.config"
export DOTFILES_DIR="$PWD"

# Version definitions
declare -A VERSIONS=(
  ["neovim"]="0.11.5"
  ["fzf"]="0.66.1"
  ["go"]="1.23.2"
  ["hugo"]="0.136.5"
  ["kubernetescli"]="1.30"
  ["kubecontext"]="0.9.5"
  ["ripgrep"]="14.1.0"
  ["gh"]="2.44.1"
  ["lazygit"]="0.40.2"
  ["tmux"]="3.3a"
  ["direnv"]="2.34.0"
  ["alacritty"]="0.13.1"
  ["pure"]="1.22.0"
)

# Log functions
log_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

log_skip() {
  echo -e "${BLUE}[SKIP]${NC} $1"
}

# Check if a command exists
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Check if a package is installed via apt
apt_package_installed() {
  dpkg -l "$1" 2>/dev/null | grep -q ^.i
}

# Check if a package is installed via brew
brew_package_installed() {
  brew list "$1" >/dev/null 2>&1
}

# Check if a cask is installed via brew
brew_cask_installed() {
  brew list --cask "$1" >/dev/null 2>&1
}

# Git clone specific version or pull if repo exists
git_clone_or_pull() {
  local repo="$1"
  local dest="$2"
  local version="$3"

  if [ -d "$dest" ]; then
    log_info "Checking for updates in $dest"
    cd "$dest"
    if [ -n "$version" ]; then
      current_version=$(git describe --tags --abbrev=0 2>/dev/null || echo "none")
      if [ "$current_version" != "$version" ]; then
        log_info "Updating to version $version..."
        git fetch --tags
        git checkout "v${version}" || git checkout "${version}"
      else
        log_skip "$dest is at correct version $version"
      fi
    else
      local changes=$(git remote update && git status -uno | grep -c "Your branch is behind")
      if [ "$changes" -gt 0 ]; then
        log_info "Updates available for $dest, pulling changes..."
        git pull
      else
        log_skip "$dest is up to date"
      fi
    fi
    cd - >/dev/null
  else
    log_info "Cloning $repo to $dest"
    git clone "$repo" "$dest"
    if [ -n "$version" ]; then
      cd "$dest"
      git checkout "v${version}" || git checkout "${version}"
      cd - >/dev/null
    fi
  fi
}

# Check OS type
detect_os() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "macos"
  elif [[ -f "/etc/os-release" ]]; then
    source /etc/os-release
    echo "${ID,,}" # Convert to lowercase
  else
    echo "unknown"
  fi
}

# Create required directories
create_directories() {
  log_info "Checking directories..."
  local directories=(
    "$XDG_CONFIG_HOME/alacritty"
    "$XDG_CONFIG_HOME/alacritty/themes"
    "$XDG_CONFIG_HOME/skhd"
    "$XDG_CONFIG_HOME/k9s"
    "$XDG_CONFIG_HOME/nvim"
    "$HOME/.zsh"
    "$HOME/.local/share/fonts"
    "$HOME/.local/bin"
  )

  for dir in "${directories[@]}"; do
    if [ ! -d "$dir" ]; then
      mkdir -p "$dir"
      log_info "Created directory: $dir"
    else
      log_skip "Directory already exists: $dir"
    fi
  done
}

# Create symbolic links
create_symlinks() {
  log_info "Checking symbolic links..."
  local items=(
    "alacritty.toml:$XDG_CONFIG_HOME/alacritty/alacritty.toml"
    ".inputrc:$HOME/.inputrc"
    ".tmux.conf:$HOME/.tmux.conf"
    "nvim:$XDG_CONFIG_HOME/nvim"
    ".zprofile:$HOME/.zprofile"
    ".zshrc:$HOME/.zshrc"
    "k9s/skin.yml:$XDG_CONFIG_HOME/k9s/skin.yml"
  )

  for item in "${items[@]}"; do
    IFS=':' read -r source target <<<"$item"

    if [ ! -e "$DOTFILES_DIR/$source" ]; then
      log_error "Source file does not exist: $source"
      continue
    fi

    if [ -L "$target" ] && [ "$(readlink "$target")" = "$DOTFILES_DIR/$source" ]; then
      log_skip "Symlink already exists and is correct: $target"
      continue
    fi

    if [ -L "$target" ]; then
      log_info "Removing existing symlink $target"
      unlink "$target"
    elif [ -d "$target" ]; then
      log_warn "$target is a directory. Skipping..."
      continue
    elif [ -e "$target" ]; then
      log_warn "$target exists. Creating backup..."
      mv "$target" "$target.backup"
    fi

    ln -s "$DOTFILES_DIR/$source" "$target"
    log_info "Created symlink for $source"
  done
}

# Install Homebrew
install_homebrew() {
  if ! command_exists brew; then
    log_info "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  else
    log_skip "Homebrew already installed"
  fi

  # Detect and initialize Homebrew path
  if [[ "$1" == "macos" ]]; then
    if [[ $(uname -m) == "arm64" ]]; then
      # Apple Silicon
      if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      else
        log_error "Expected Homebrew at /opt/homebrew not found."
      fi
    else
      # Intel Mac
      if [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
      else
        log_error "Expected Homebrew at /usr/local not found."
      fi
    fi
  else
    # Linuxbrew
    if [ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    else
      log_error "Expected Homebrew at /home/linuxbrew/.linuxbrew not found."
    fi
  fi
}

# Install macOS packages with version pinning
install_macos_packages() {
  log_info "Checking macOS packages..."

  if [[ $(uname -m) == 'arm64' ]]; then
    if ! pgrep oahd >/dev/null 2>&1; then
      log_info "Installing Rosetta 2..."
      softwareupdate --install-rosetta --agree-to-license
    else
      log_skip "Rosetta 2 already installed"
    fi
  fi

  # Define packages to install with versions
  local brew_packages=(
 #   "amethyst"
 #   "fzf@${VERSIONS[fzf]}"
     "fzf"
 #   "neovim@${VERSIONS[neovim]}"
     "neovim"
#    "exa"
#    "go@${VERSIONS[go]}"
#    "hugo@${VERSIONS[hugo]}"
    "bash-completion@2"
    "newsboat"
#    "kubernetes-cli@${VERSIONS[kubernetescli]}"
    "kubernetes-cli"
#    "kubecontext@${VERSIONS[kubecontext]}"
    "kubecontext"
#    "ripgrep@${VERSIONS[ripgrep]}"
    "ripgrep"
#    "gh@${VERSIONS[gh]}"
    "gh"
#    "lazygit@${VERSIONS[lazygit]}"
    "lazygit"
#    "tmux@${VERSIONS[tmux]}"
    "tmux"
#    "direnv@${VERSIONS[direnv]}"
    "direnv"
    "reattach-to-user-namespace"
    "gnupg"
  )

  local cask_packages=(
    "alacritty@${VERSIONS[alacritty]}"
  )

  # Install brew packages
  for package in "${brew_packages[@]}"; do
    local base_package="${package%@*}"
    local version="${package#*@}"

    if ! brew_package_installed "$base_package"; then
      log_info "Installing $base_package@$version..."
      if [ "$version" == "$base_package" ]; then
        brew install "$base_package"
      else
        brew install "$base_package@$version"
      fi
    else
      local installed_version=$(brew list --versions "$base_package" | awk '{print $2}')
      if [ "$version" != "$base_package" ] && [ "$installed_version" != "$version" ]; then
        log_info "Updating $base_package to version $version..."
        brew upgrade "$base_package@$version"
      else
        log_skip "$base_package already installed at correct version"
      fi
    fi
  done

  # Install cask packages
  for package in "${cask_packages[@]}"; do
    local base_package="${package%@*}"
    local version="${package#*@}"

    if ! brew_cask_installed "$base_package"; then
      log_info "Installing cask $base_package@$version..."
      brew install --cask "$base_package"
    else
      local installed_version=$(brew info --cask "$base_package" | grep "${base_package}:" | awk '{print $3}')
      if [ "$version" != "$base_package" ] && [ "$installed_version" != "$version" ]; then
        log_info "Updating $base_package to version $version..."
        brew upgrade --cask "$base_package"
      else
        log_skip "Cask $base_package already installed at correct version"
      fi
    fi
  done
}

# Install Ubuntu packages with version pinning
install_ubuntu_packages() {
  log_info "Checking Ubuntu packages..."

  if [ ! -f "/var/cache/apt/pkgcache.bin" ] || [ "$(find /var/cache/apt/pkgcache.bin -mmin +60)" ]; then
    log_info "Updating package list..."
    sudo apt-get update
  fi

  local apt_packages=(
    "build-essential"
    "curl"
    "wget"
    "git"
    "zsh"
    "gcc"
    "g++"
    "unzip"
    "python3-pip"
    "fzf"
    "ripgrep"
    "fd-find"
  )

  for package in "${apt_packages[@]}"; do
    if ! apt_package_installed "$package"; then
      log_info "Installing $package..."
      sudo apt-get install -y "$package"
    else
      log_skip "$package already installed"
    fi
  done

  # Install specific versioned tools
  if ! command_exists direnv || [[ $(direnv version) != "${VERSIONS[direnv]}" ]]; then
    log_info "Installing direnv ${VERSIONS[direnv]}..."
    curl -sfL "https://github.com/direnv/direnv/releases/download/v${VERSIONS[direnv]}/direnv.linux-amd64" -o "$HOME/.local/bin/direnv"
    chmod +x "$HOME/.local/bin/direnv"
  else
    log_skip "direnv already installed at correct version"
  fi

  # Install brew packages
  local brew_packages=(
    "neovim@${VERSIONS[neovim]}"
    "go@${VERSIONS[go]}"
    "lazygit@${VERSIONS[lazygit]}"
    "kubectl@${VERSIONS[kubectl]}"
    "kubectx@${VERSIONS[kubectx]}"
  )

  for package in "${brew_packages[@]}"; do
    local base_package="${package%@*}"
    local version="${package#*@}"

    if ! brew_package_installed "$base_package"; then
      log_info "Installing $base_package@$version via brew..."
      brew install "$base_package@$version"
    else
      local installed_version=$(brew list --versions "$base_package" | awk '{print $2}')
      if [ "$version" != "$base_package" ] && [ "$installed_version" != "$version" ]; then
        log_info "Updating $base_package to version $version..."
        brew upgrade "$base_package@$version"
      else
        log_skip "$base_package already installed at correct version via brew"
      fi
    fi
  done
}

# Install common dependencies
install_common_deps() {
  log_info "Checking common dependencies..."

  # Install pure prompt with version
  git_clone_or_pull "https://github.com/sindresorhus/pure.git" "$HOME/.zsh/pure" "${VERSIONS[pure]}"

  # Install alacritty themes
  git_clone_or_pull "https://github.com/alacritty/alacritty-theme" "$XDG_CONFIG_HOME/alacritty/themes"

  local fonts_dir="$HOME/.local/share/fonts"
  local fonts_updated=false

  for font in "$DOTFILES_DIR"/fonts/UbuntuMono*; do
    local font_name=$(basename "$font")
    if [ ! -f "$fonts_dir/$font_name" ] || ! cmp -s "$font" "$fonts_dir/$font_name"; then
      log_info "Copying font: $font_name"
      cp "$font" "$fonts_dir/"
      fonts_updated=true
    else
      log_skip "Font already exists: $font_name"
    fi
  done

  if [[ "$1" == "linux" ]] && [ "$fonts_updated" = true ]; then
    log_info "Updating font cache..."
    fc-cache -f -v
  fi

  if [[ "$1" == "macos" ]] && [ "$fonts_updated" = true ]; then
    log_info "Copying fonts to Library/Fonts for macOS..."
    local mac_fonts_dir="$HOME/Library/Fonts"
    for font in "$DOTFILES_DIR"/fonts/UbuntuMono*; do
      local font_name=$(basename "$font")
      if [ ! -f "$mac_fonts_dir/$font_name" ] || ! cmp -s "$font" "$mac_fonts_dir/$font_name"; then
        cp "$font" "$mac_fonts_dir/"
        log_info "Copied font: $font_name to $mac_fonts_dir"
      else
        log_skip "Font already exists in $mac_fonts_dir: $font_name"
      fi
    done
  fi

  # Install specific version of pynvim
  if ! python3 -m pip list | grep -q "pynvim"; then
    log_info "installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    log_info "Installing pynvim..."
    uv tool install --upgrade pynvim
  else
    log_skip "pynvim already installed"
  fi
}

# Set zsh as default shell
set_zsh_default() {
  if [[ $SHELL != *"zsh"* ]]; then
    log_info "Setting zsh as default shell..."
    chsh -s "$(which zsh)"
  else
    log_skip "zsh is already the default shell"
  fi
}

# Main installation function
main() {
  local os_type
  os_type=$(detect_os)

  log_info "Detected OS: $os_type"

  # Create necessary directories
  create_directories

  # Install Homebrew (for both OS types)
  install_homebrew "$os_type"

  # OS-specific installations
  case "$os_type" in
  "macos")
    install_macos_packages
    ;;
  "ubuntu")
    install_ubuntu_packages
    ;;
  *)
    log_error "Unsupported OS: $os_type"
    exit 1
    ;;
  esac

  # Install common dependencies
  install_common_deps "$os_type"

  # Create symlinks
  create_symlinks

  # Set zsh as default shell
  set_zsh_default

  log_info "Setup complete! Please restart your terminal."
}

# Run the script
main "$@"
